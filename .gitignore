###################
# Docker
###################

# Don't commit docker-compose overrides (personal dev configs)
docker-compose.override.yml
docker-compose.override.yaml

# Docker build cache (if using BuildKit)
.dockerignore

# Docker volumes (local data directories)
/data/
/postgres-data/
/redis-data/

###################
# Databases
###################

# SQLite (if you use it for testing)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# PostgreSQL local dumps
*.sql
*.dump
*.backup

# Database migration scripts (KEEP your EF migrations though!)
# Only ignore if you generate throwaway scripts
/sql-scripts/temp/

###################
# Environment & Secrets
###################

# CRITICAL: Never commit secrets!
.env
.env.local
.env.development
.env.production
.env.*.local

# Application settings with secrets
appsettings.Development.json
appsettings.Staging.json
appsettings.Production.json
# KEEP: appsettings.json (base config without secrets)

# Secret management
secrets.json
*.pfx
*.p12
*.key
*.pem

