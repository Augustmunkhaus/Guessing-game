@using BlazorBootstrap
@using Metaldle.BlazorWASM.Services
@inject MetaldleApiService _apiService
@inject IJSRuntime JS

<div class="row">
    <div class="col-md-5 col-sm-12">
        <!-- Autocomplete input - filters allEntities as user types -->
        <AutoComplete @bind-Value="entityName"
                      TItem="EntityOption"
                      DataProvider="EntityDataProvider"
                      PropertyName="Name"
                      Placeholder="Search an entity..."
                      OnChanged="(EntityOption value) => OnAutoCompleteChanged(value)"/>
    </div>
    <div class="col-md-5 col-sm-12">
        <!-- Fires SubmitSearch event up to Index.razor with the selected band name -->
        <button @onclick="OnSubmitClicked">Submit guess</button>
    </div>
</div>

@code {
    // Wrapper class to display items correctly
    public class EntityOption
    {
        public string Name { get; set; } = "";
    }
    
    private async Task OnSubmitClicked()
    {
        // Only submit if the entity name exists in the valid list
        if (string.IsNullOrWhiteSpace(entityName))
            return;

        var isValid = allEntities?.Any(e =>
            e.Name.Equals(entityName, StringComparison.OrdinalIgnoreCase)) ?? false;

        if (!isValid)
            return;

        await SubmitSearch.InvokeAsync(entityName);
        entityName = null;
    }
    // Sends the selected band name up to Index.razor when submit is clicked
    [Parameter]
    public EventCallback<string> SubmitSearch { get; set; }
    
    // Holds the currently selected band name
    private string? entityName;
    
    // List containing all entities
    private List<EntityOption>? allEntities;
    
    //calling api to fetch all entity names
    protected override async Task OnInitializedAsync()
    {
        var names = await _apiService.GetAllEntitiesAsync();
        allEntities = names?.Select(n => new EntityOption { Name = n }).ToList();
    }
    // Filters the local entity list based on what the user is typing
    private Task<AutoCompleteDataProviderResult<EntityOption>> EntityDataProvider(AutoCompleteDataProviderRequest<EntityOption> request)
    {
        var filtered = allEntities?
            .Where(x => x.Name.Contains(request.Filter.Value, StringComparison.OrdinalIgnoreCase))
            .ToList() ?? new List<EntityOption>();
        
        return Task.FromResult(new AutoCompleteDataProviderResult<EntityOption> { Data = filtered });
    }
    
    // Invokes the SubmitSearch callback with the selected band name
    private void OnAutoCompleteChanged(EntityOption value)
    {
        Console.WriteLine($"'{value}' selected.");
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("registerEnterKey", DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public async Task SubmitOnEnter()
    {
        await OnSubmitClicked();
        StateHasChanged();
    }
}