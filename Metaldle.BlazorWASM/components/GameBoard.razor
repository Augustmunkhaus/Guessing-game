@using Metaldle.BlazorWASM.Models

@if (Guesses == null)
{
    return;
}

@if (Guesses != null && Guesses.Any())
{
    <div class="guess-counter">
        @for (int i = 0; i < 8; i++)
        {
            var isUsed = i < Guesses.Count;
            <span class="skull-icon @(isUsed ? "used" : "")">💀</span>
        }
    </div>
}

@if (Guesses != null && Guesses.Any())
{
    <div class="guess-row">
        <div class="cell header-cell">Name</div>
        <div class="cell header-cell">Year</div>
        <div class="cell header-cell">Members</div>
        <div class="cell header-cell">Country</div>
        <div class="cell header-cell">Continent</div>
        <div class="cell header-cell">Status</div>
        <div class="cell header-cell">Genre</div>
        <div class="cell header-cell">Themes</div>
        <div class="cell header-cell">Vocals</div>
        <div class="cell header-cell">Sub genres</div>
    </div>
}

@{ var rowIndex = 0; }
@foreach (var item in Guesses)
{
    {
        var numeric1 = GetNumericFeedback(item.Feedback.Numeric1);
        var numeric2 = GetNumericFeedback(item.Feedback.Numeric2);
        var isNewRow = rowIndex == Guesses.Count - 1 && _animatingRowIndex == rowIndex;

        <div class="guess-row @(isNewRow ? "animate-row" : "")">
            <div class="cell name-cell @(isNewRow ? "cell-flip" : "")" style="--cell-index: 0">@item.GuessedEntityName</div>
            <div class="cell @(isNewRow ? "cell-flip" : "")" style="background-color: @numeric1.color; --cell-index: 1">
                <span>@item.Feedback.Numeric1.Value</span>
                <span>&nbsp;</span>
                <span class="direction-symbol">@numeric1.direction</span>
            </div>
            <div class="cell @(isNewRow ? "cell-flip" : "")" style="background-color: @numeric2.color; --cell-index: 2">
                <span>@item.Feedback.Numeric2.Value</span>
                <span>&nbsp;</span>
                <span class="direction-symbol">@numeric2.direction</span>
            </div>
            <div class="cell @(isNewRow ? "cell-flip" : "")" style="background-color: @GetCategoryColor(item.Feedback.Region); --cell-index: 3">@item.Feedback.Region.Value</div>
            <div class="cell @(isNewRow ? "cell-flip" : "")" style="background-color: @GetCategoryColor(item.Feedback.Continent); --cell-index: 4">@item.Feedback.Continent.Value</div>
            <div class="cell @(isNewRow ? "cell-flip" : "")" style="background-color: @GetCategoryColor(item.Feedback.Status); --cell-index: 5">@item.Feedback.Status.Value</div>
            <div class="cell @(isNewRow ? "cell-flip" : "")" style="background-color: @GetCategoryColor(item.Feedback.Genre); --cell-index: 6">@item.Feedback.Genre.Value</div>

            <div class="cell @(isNewRow ? "cell-flip" : "")" style="background-color: @GetListColor(item.Feedback.List1); --cell-index: 7">@string.Join(", ", item.Feedback.List1.Values)</div>
            <div class="cell @(isNewRow ? "cell-flip" : "")" style="background-color: @GetListColor(item.Feedback.List2); --cell-index: 8">@string.Join(", ", item.Feedback.List2.Values)</div>
            <div class="cell @(isNewRow ? "cell-flip" : "")" style="background-color: @GetListColor(item.Feedback.List3); --cell-index: 9">@string.Join(", ", item.Feedback.List3.Values)</div>
        </div>

        rowIndex++;
    }
}
@if (TargetBand != null && Status == "Lost")
{
    <div class="guess-row">
        <div class="cell name-cell">@TargetBand.Name</div>
        <div class="cell" style="background-color: green">@TargetBand.Year</div>
        <div class="cell" style="background-color: green">@TargetBand.Members</div>
        <div class="cell" style="background-color: green">@TargetBand.Country</div>
        <div class="cell" style="background-color: green">@TargetBand.Continent</div>
        <div class="cell" style="background-color: green">@TargetBand.Status</div>
        <div class="cell" style="background-color: green">@TargetBand.Genre</div>
        <div class="cell" style="background-color: green">@string.Join(", ", TargetBand.Themes)</div>
        <div class="cell" style="background-color: green">@string.Join(", ", TargetBand.Vocals)</div>
        <div class="cell" style="background-color: green">@string.Join(", ", TargetBand.SubGenres)</div>
    </div>
}

@code {
    [Parameter] public List<GuessResponse> Guesses { get; set; }

    [Parameter] public TargetBandResponse? TargetBand { get; set; }

    [Parameter] public string? Status { get; set; }

    private int _previousGuessCount = 0;
    private int _animatingRowIndex = -1;

    protected override void OnParametersSet()
    {
        if (Guesses != null && Guesses.Count > _previousGuessCount)
        {
            _animatingRowIndex = Guesses.Count - 1;
            _previousGuessCount = Guesses.Count;
        }
        else if (Guesses == null || Guesses.Count == 0)
        {
            _previousGuessCount = 0;
            _animatingRowIndex = -1;
        }
    }

    public (string color, string direction) GetNumericFeedback(NumericFeedback feedback)
    {
        switch (feedback.Direction)
        {
            case "Higher":
                return ("#7a1a1a", "↑");
            case "Lower":
                return ("#7a1a1a", "↓");
            case "Exact":
                return ("#2d6a2d", "");
            case "HigherClose":
                return ("#8a7a1a", "↑");
            case "LowerClose":
                return ("#8a7a1a", "↓");
            default:
                return ("grey", "?");
        }
    }

    public string GetCategoryColor(CategoryFeedback feedback)
    {
        switch (feedback.Match)
        {
            case "None":
                return "#7a1a1a";
            case "Partial":
                return "#8a7a1a";
            case "Exact":
                return "#2d6a2d";
            default:
                return "grey";
        }
    }

    public string GetListColor(ListFeedback feedback)
    {
        switch (feedback.Match)
        {
            case "None":
                return "#7a1a1a";
            case "Partial":
                return "#8a7a1a";
            case "Exact":
                return "#2d6a2d";
            default:
                return "grey";
        }
    }

}
