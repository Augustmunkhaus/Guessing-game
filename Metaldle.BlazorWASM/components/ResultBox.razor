@using Metaldle.BlazorWASM.Models
@using Metaldle.BlazorWASM.Services
@inject SpotifyService SpotifyService
@inject MetaldleApiService ApiService
@inject SessionService SessionService
@using Metaldle.BlazorWASM.components

<div class="overlay animate-overlay">
    @if (Status == "Won")
    {
        <div class="confetti-container">
            @for (int i = 0; i < 50; i++)
            {
                var left = Random.Shared.Next(0, 100);
                var delay = Random.Shared.NextDouble() * 3;
                var duration = 2 + Random.Shared.NextDouble() * 2;
                var colors = new[] { "#c9a84c", "#e8c97a", "#ff6b6b", "#4ecdc4", "#ffe66d" };
                var color = colors[Random.Shared.Next(colors.Length)];
                <div class="confetti-piece" style="left: @(left)%; animation-delay: @(delay.ToString("F2"))s; animation-duration: @(duration.ToString("F2"))s; background-color: @color;"></div>
            }
        </div>
    }
    <div class="result-box @(Status == "Won" ? "result-win" : "result-lose")">
        <button class="close-btn" @onclick="OnClose">✕</button>
        @if (Status == "Won")
        {
            <h1>You got it!</h1>
        }
        else
        {
            <h1>Better luck next time!</h1>
        }

        @if (TargetBand != null)
        {
            <div class="band-image-container">
                @if (!string.IsNullOrEmpty(TargetBand.ImageUrl))
                {
                    <img src="@TargetBand.ImageUrl" alt="@TargetBand.Name" class="band-image" />
                }
                <h2 class="band-name">@TargetBand.Name</h2>
            </div>
        }

        @if (TargetBand != null)
        {
            <div class="result-band-wrapper">
                <div class="result-band-grid">
                    <div class="guess-row">
                        <div class="cell header-cell">Name</div>
                        <div class="cell header-cell">Year</div>
                        <div class="cell header-cell">Members</div>
                        <div class="cell header-cell">Country</div>
                        <div class="cell header-cell">Continent</div>
                        <div class="cell header-cell">Status</div>
                        <div class="cell header-cell">Genre</div>
                        <div class="cell header-cell">Themes</div>
                        <div class="cell header-cell">Vocals</div>
                        <div class="cell header-cell">Sub Genres</div>
                    </div>
                    <div class="guess-row">
                        <div class="cell name-cell">@TargetBand.Name</div>
                        <div class="cell" style="background-color: green">@TargetBand.Year</div>
                        <div class="cell" style="background-color: green">@TargetBand.Members</div>
                        <div class="cell" style="background-color: green">@TargetBand.Country</div>
                        <div class="cell" style="background-color: green">@TargetBand.Continent</div>
                        <div class="cell" style="background-color: green">@TargetBand.Status</div>
                        <div class="cell" style="background-color: green">@TargetBand.Genre</div>
                        <div class="cell" style="background-color: green">@string.Join(", ", TargetBand.Themes)</div>
                        <div class="cell" style="background-color: green">@string.Join(", ", TargetBand.Vocals)</div>
                        <div class="cell" style="background-color: green">@string.Join(", ", TargetBand.SubGenres)</div>
                    </div>
                </div>
            </div>
        }
        
        @if (!string.IsNullOrEmpty(_spotifyTrackId))
        {
            <iframe src="https://open.spotify.com/embed/track/@_spotifyTrackId"
                    width="100%" height="80" frameborder="0"
                    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture">
            </iframe>
        }
        
        @if (IsDailyGame)
        {
            <div class="leaderboard-section">
                @if (!_submitted)
                {
                    <p>How did you do compared to others?</p>
                    <input @bind="_displayName" maxlength="20" placeholder="Enter your name (max 20 chars)..." />
                    <button @onclick="SubmitScore">Submit</button>
                    @if (_errorMessage != null)
                    {
                        <p class="error">@_errorMessage</p>
                    }
                }
                else
                {
                    <div class="leaderboard-buttons">
                        <button @onclick='() => OnLeaderboardRequested.InvokeAsync(_displayName)'>See Leaderboard 🤘</button>
                        <button @onclick="OnNewGame">New Game</button>
                    </div>
                }
            </div>
        }

    </div>
    
    
</div>

@code {
    [Parameter] public TargetBandResponse? TargetBand { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string? Status { get; set; }
    [Parameter] public EventCallback<string> OnLeaderboardRequested { get; set; }
    [Parameter] public bool IsDailyGame { get; set; } = true;
    [Parameter] public EventCallback OnNewGame { get; set; }
    private string? _spotifyTrackId;
    
    protected override async Task OnParametersSetAsync()
    {
        if (TargetBand != null)
        {
            _spotifyTrackId = await SpotifyService.GetTrackIdAsync(TargetBand.Name);
        }
    }
    
    private string _displayName = "";
    private bool _submitted = false;
    private string? _errorMessage;
    
    private async Task SubmitScore()
    {
        if (string.IsNullOrWhiteSpace(_displayName))
        {
            _errorMessage = "Please enter a name!";
            return;
        }

        if (_displayName.Length > 20)
        {
            _errorMessage = "Name must be 20 characters or less!";
            return;
        }

        var sessionId = await SessionService.GetOrCreateSessionIdAsync();
        var success = await ApiService.SubmitLeaderboardEntryAsync(sessionId, _displayName.Trim());

        if (success)
        {
            _submitted = true;
            _errorMessage = null;
        }
        else
        {
            _errorMessage = "Could not submit score. Have you already submitted?";
        }
    }
}